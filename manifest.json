{
  "name": "Fyde Word - Offline DOCX Editor",
  "short_name": "Fyde Word",
  "description": "Editor dokumen offline bergaya Microsoft Word untuk FydeOS dengan DOCX Import dan Export v1.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e8e8e8",
  "theme_color": "#185ABD",
  "orientation": "any",
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "shortcuts": [
    {
      "name": "New Document",
      "short_name": "New",
      "url": "./index.html?new=1",
      "icons": [
        {
          "src": "./icons/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Open Document",
      "short_name": "Open",
      "url": "./index.html?open=1",
      "icons": [
        {
          "src": "./icons/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}