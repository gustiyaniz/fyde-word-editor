{
  "name": "Fyde Word - Offline Document Editor",
  "short_name": "Fyde Word",
  "description": "Editor dokumen offline bergaya Microsoft Word untuk FydeOS.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e8e8e8",
  "theme_color": "#185ABD",
  "orientation": "any",
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "New Document",
      "short_name": "New",
      "url": "./index.html?new=1"
    }
  ]
}